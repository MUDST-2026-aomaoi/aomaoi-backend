# Copy this file to .env beside docker-compose.yml before running Docker Compose.
# The regular Compose stack uses its own PostgreSQL container. These DB_* values
# initialize that container only when its data volume is first created.
DB_NAME=aomaoi_db
DB_USER=aomaoi_user
DB_PASSWORD=aomaoi_password
# Host port for PostgreSQL; the containers connect to postgres:5432 instead.
DB_PORT=5434

# For running Spring Boot directly on your host. Compose overrides these three
# values for its app and migrate containers with the internal postgres address.
# Keep them in sync with DB_NAME, DB_USER, DB_PASSWORD, and DB_PORT above.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/aomaoi_db
SPRING_DATASOURCE_USERNAME=aomaoi_user
SPRING_DATASOURCE_PASSWORD=aomaoi_password

# Replace this example before sharing or deploying. HS256 needs at least 32
# UTF-8 bytes; use a different random secret in each environment.
JWT_SECRET=replace-with-a-unique-random-jwt-secret-at-least-32-bytes-long
# Compose does not use this for its Liquibase demo account. It applies only if
# the application seeder is enabled outside Compose.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-initial-password

# Compose fixes APP_SEED_ENABLED=false for app and migrate. Its migrate service
# runs Liquibase with the demo context, which adds demo users/farms/work logs.
# These flags matter only when running Spring Boot directly outside Compose.
APP_SEED_ENABLED=false
APP_SEED_DEMO_DATA=false

# Keep 8080 inside the app container: Compose publishes it on host port 8081.
SERVER_PORT=8080
JWT_EXPIRATION=86400000

# Compose's frontend host port defaults to 3000. To override it, add
# FRONTEND_PORT=5173 to your .env; the container still listens on port 80.

# Optional Hikari settings for a separately managed database:
# DB_POOL_MAX_SIZE=2
# DB_POOL_MIN_IDLE=0

# Shared-system Cypress cleanup key; blank disables test-run creation.
# Generate a private random value of at least 32 characters. Never commit .env.
E2E_SUPPORT_KEY=
