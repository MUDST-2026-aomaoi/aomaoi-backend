# Supabase PostgreSQL connection. Copy the JDBC host/database from Supabase's Connect panel.
# Use direct connection for reachable long-running backends, or session pooler if required.
SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<supabase-database-user>
SPRING_DATASOURCE_PASSWORD=<supabase-database-password>

# Required application secrets; use separate values per environment.
JWT_SECRET=<long-random-secret>
BOOTSTRAP_ADMIN_PASSWORD=<initial-superadmin-password>

# Enable sample records only for an isolated development or test Supabase project.
APP_SEED_ENABLED=true
APP_SEED_DEMO_DATA=true

SERVER_PORT=8080
JWT_EXPIRATION=86400000
