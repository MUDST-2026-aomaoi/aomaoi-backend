# Docker Compose PostgreSQL settings. DB_PORT is the port exposed on your host.
DB_NAME=aomaoi_db
DB_USER=aomaoi_user
DB_PASSWORD=aomaoi_password
DB_PORT=5434

# For running Spring Boot directly on your host (Compose overrides these internally).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/aomaoi_db
SPRING_DATASOURCE_USERNAME=aomaoi_user
SPRING_DATASOURCE_PASSWORD=aomaoi_password

# Required application secrets; use separate values per environment.
JWT_SECRET=<long-random-secret>
BOOTSTRAP_ADMIN_PASSWORD=<initial-superadmin-password>

# Enable sample records only for an isolated development or test database.
APP_SEED_ENABLED=true
APP_SEED_DEMO_DATA=false

SERVER_PORT=8080
JWT_EXPIRATION=86400000
