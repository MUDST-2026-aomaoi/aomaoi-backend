#!/bin/sh
# Git Pre-commit hook: Auto-export latest PostgreSQL data before commit

# Determine correct docker command (prefer docker.exe on Windows Git Bash)
if command -v docker.exe >/dev/null 2>&1; then
    DOCKER_BIN="docker.exe"
elif command -v docker >/dev/null 2>&1; then
    DOCKER_BIN="docker"
else
    exit 0
fi

# Check if aomaoi-postgres container is running
if $DOCKER_BIN ps --format '{{.Names}}' | grep -q '^aomaoi-postgres$'; then
    echo "📦 [Git Hook] Exporting latest database records from aomaoi-postgres..."
    OUTPUT_FILE="liquibase/changes/999-latest-data.sql"

    # Write Liquibase Formatted SQL header
    cat << 'EOF' > "$OUTPUT_FILE"
--liquibase formatted sql

--changeset auto:latest-data runOnChange:true
--comment: Automatically exported latest database records
EOF

    # Export database data with --on-conflict-do-nothing and filter out psql meta-commands (like \restrict)
    $DOCKER_BIN exec aomaoi-postgres pg_dump -U aomaoi_user -d aomaoi_db \
        --data-only \
        --inserts \
        --on-conflict-do-nothing \
        --exclude-table=databasechangelog \
        --exclude-table=databasechangeloglock | sed '/^\\/d' >> "$OUTPUT_FILE"

    # Stage the updated file into current git commit
    git add "$OUTPUT_FILE"
    echo "✅ [Git Hook] Database records exported and added to commit."
else
    echo "ℹ️ [Git Hook] Container 'aomaoi-postgres' is not running. Skipped DB export."
fi
