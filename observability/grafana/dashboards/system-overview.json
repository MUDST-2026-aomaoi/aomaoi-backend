{
  "uid": "aomaoi-overview",
  "title": "AOMAOI System Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {"id":1,"type":"stat","title":"Backend up","gridPos":{"x":0,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"up{job=\"aomaoi-backend\"}","legendFormat":"up"}],"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"}},
    {"id":2,"type":"timeseries","title":"HTTP requests / second","gridPos":{"x":6,"y":0,"w":9,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{application=\"aomaoi-backend\"}[5m]))","legendFormat":"requests/s"}]},
    {"id":3,"type":"timeseries","title":"HTTP 5xx rate","gridPos":{"x":15,"y":0,"w":9,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{application=\"aomaoi-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"aomaoi-backend\"}[5m])), 0.1)","legendFormat":"5xx ratio"}]},
    {"id":4,"type":"timeseries","title":"HTTP p95 latency","gridPos":{"x":0,"y":4,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"aomaoi-backend\"}[5m])))","legendFormat":"p95"}]},
    {"id":5,"type":"timeseries","title":"JVM heap used","gridPos":{"x":12,"y":4,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(jvm_memory_used_bytes{application=\"aomaoi-backend\",area=\"heap\"})","legendFormat":"heap used"}]},
    {"id":6,"type":"timeseries","title":"Process CPU usage","gridPos":{"x":0,"y":11,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"process_cpu_usage{application=\"aomaoi-backend\"}","legendFormat":"process"},{"expr":"system_cpu_usage{application=\"aomaoi-backend\"}","legendFormat":"system"}]},
    {"id":7,"type":"timeseries","title":"Database connection pool","gridPos":{"x":12,"y":11,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"hikaricp_connections_active{application=\"aomaoi-backend\"}","legendFormat":"active"},{"expr":"hikaricp_connections_max{application=\"aomaoi-backend\"}","legendFormat":"max"},{"expr":"hikaricp_connections_pending{application=\"aomaoi-backend\"}","legendFormat":"pending"}]}
  ]
}
